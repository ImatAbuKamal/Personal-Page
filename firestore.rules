rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PersonaPage Security Rules
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a "Public Portfolio, Protected Admin" model. 
     * Most content (Home, Projects, About Me) is globally readable to allow 
     * visitors to view the portfolio, but strictly modifiable only by 
     * authorized administrators.
     *
     * DATA STRUCTURE:
     * - Public Content: Top-level collections (/projects, /carouselSlides, etc.) 
     *   accessible by everyone for reading.
     * - User Submissions: The /messages collection allows public creation 
     *   (contact form) but restricts reading to administrators.
     * - Admin Registry: A dedicated /roles_admin collection serves as the 
     *   source of truth for administrative privileges via DBAC (Database-Based 
     *   Access Control).
     *
     * KEY SECURITY DECISIONS:
     * - Administrative access is determined by the existence of a document 
     *   at /roles_admin/{userId}.
     * - Public 'create' is allowed for messages to facilitate the contact 
     *   form functionality without requiring visitor authentication.
     * - Relational integrity is enforced by ensuring the document 'id' 
     *   field matches the Firestore Document ID.
     *
     * DENORMALIZATION FOR AUTHORIZATION:
     * For this portfolio, authorization is primarily role-based (Admin vs. Public).
     * We use a global admin check (isAdmin()) which performs a lookup on the 
     * roles_admin collection to authorize management tasks across all collections.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user has an entry in the admin roles collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Verifies if a document exists and the user is an admin for updates/deletes. */
    function isAdminAndExists() {
      return resource != null && isAdmin();
    }

    // --- Collection Rules ---

    /**
     * @description Rules for homepage hero section content.
     * @path /homeContent/{contentId}
     * @allow (get) Public access. (update) Authenticated Admin.
     * @deny (write) Any non-admin user.
     * @principle Role-based write access with public read.
     */
    match /homeContent/{contentId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == contentId;
      allow update, delete: if isAdminAndExists();
    }

    /**
     * @description Rules for the homepage image carousel.
     * @path /carouselSlides/{slideId}
     * @allow (list) Public access. (create) Authenticated Admin.
     * @deny (delete) Any non-admin user.
     * @principle Role-based write access for collection items.
     */
    match /carouselSlides/{slideId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == slideId;
      allow update, delete: if isAdminAndExists();
    }

    /**
     * @description Rules for the portfolio owner's biography and skills.
     * @path /aboutMe/{contentId}
     * @allow (get) Public access. (update) Authenticated Admin.
     * @deny (create) Mismatched ID.
     * @principle Path-to-data consistency for singletons.
     */
    match /aboutMe/{contentId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == contentId;
      allow update, delete: if isAdminAndExists();
    }

    /**
     * @description Rules for portfolio gallery projects.
     * @path /projects/{projectId}
     * @allow (list) Public access. (delete) Authenticated Admin.
     * @deny (update) Anonymous visitors.
     * @principle Public consumption with administrative management.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == projectId;
      allow update, delete: if isAdminAndExists();
    }

    /**
     * @description Rules for contact details and map URLs.
     * @path /contactInfo/{contentId}
     * @allow (get) Public access. (update) Authenticated Admin.
     * @deny (delete) Any non-admin.
     * @principle Administrative lockdown for sensitive configuration.
     */
    match /contactInfo/{contentId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == contentId;
      allow update, delete: if isAdminAndExists();
    }

    /**
     * @description Rules for footer links and copyright info.
     * @path /footerContent/{contentId}
     * @allow (get) Public access. (update) Authenticated Admin.
     * @deny (create) Mismatched ID.
     * @principle Singleton document integrity and role-based access.
     */
    match /footerContent/{contentId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == contentId;
      allow update, delete: if isAdminAndExists();
    }

    /**
     * @description Rules for visitor contact form submissions.
     * @path /messages/{messageId}
     * @allow (create) Publicly accessible for form submission. (list) Authenticated Admin.
     * @deny (get) Non-admin users. (update) No one (messages are immutable).
     * @principle Public-write / Admin-read segregation for inbox patterns.
     */
    match /messages/{messageId} {
      allow create: if request.resource.data.id == messageId;
      allow get, list, delete: if isAdmin();
      allow update: if false; // Messages should not be modified once sent
    }

    /**
     * @description Registry of administrative users.
     * @path /roles_admin/{adminId}
     * @allow (get) Any signed-in user checking their own status.
     * @deny (write) All client-side requests.
     * @principle Database-Based Access Control (DBAC) source of truth.
     */
    match /roles_admin/{adminId} {
      // Users can check if they themselves are admins
      allow get: if isSignedIn() && request.auth.uid == adminId;
      // Admins can list other admins
      allow list: if isAdmin();
      // Admin roles are typically managed via Admin SDK/Console for security
      allow create, update, delete: if false;
    }
  }
}